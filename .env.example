# Django API base URL (server-side only; the browser talks to /api/backend/*)
API_URL=http://127.0.0.1:8000
# Production (Vercel env var): API_URL=https://mess-meal-management-system-backend.onrender.com
# Keep these in sync with the Django SIMPLE_JWT lifetimes (cookie max-age)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
